# Required. Get the API key from https://trello.com/app-key.
# Do not commit real values.
TRELLO_API_KEY=replace_with_trello_api_key
TRELLO_TOKEN=replace_with_trello_token

# Optional default board. Can be switched at runtime via set_active_board.
TRELLO_BOARD_ID=

# Optional default workspace. Can be switched at runtime via set_active_workspace.
TRELLO_WORKSPACE_ID=

# Optional for the CLI on macOS.
# When set, the CLI reads <PREFIX>_API_KEY, <PREFIX>_TOKEN, and <PREFIX>_BOARD_ID
# from the macOS Keychain after checking process env and .env.
# TRELLO_KEYCHAIN_PREFIX=TRELLO
