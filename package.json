{
  "name": "@ftaricano/mcp-server-trello",
  "version": "1.5.0",
  "description": "Professional Model Context Protocol server and CLI for Trello boards, lists, cards, checklists, and workspaces.",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "mcp-server-trello": "./build/index.js",
    "trello": "./build/cli.js"
  },
  "scripts": {
    "build:dev": "NODE_OPTIONS='--max-old-space-size=8192' tsc && chmod +x build/index.js build/cli.js",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsc && terser build/index.js --compress drop_console=true --mangle --output build/index.js && chmod +x build/index.js build/cli.js",
    "start": "node build/index.js",
    "dev": "ts-node --esm src/index.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "if [ \"$SKIP_PREPARE\" != \"true\" ]; then npm run build; fi",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ftaricano/mcp-server-trello.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "trello",
    "trello-api",
    "api",
    "integration",
    "automation",
    "ai-agents",
    "cli",
    "typescript",
    "board-management",
    "task-management",
    "kanban"
  ],
  "author": "Ferd Taricano",
  "contributors": [
    "Jarad DeLorenzo"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ftaricano/mcp-server-trello/issues"
  },
  "homepage": "https://github.com/ftaricano/mcp-server-trello#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "axios": "^1.6.2",
    "commander": "^12.1.0",
    "dotenv": "^17.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "terser": "^5.24.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "vitest": "^4.1.5"
  },
  "files": [
    "build/**/*",
    "NOTICE.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
